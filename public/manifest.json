{
  "manifest_version": 3,
  "name": "Shelf",
  "version": "1.0.0",
  "description": "Save webpages for later with a short note, and get reminded at a chosen time.",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "contextMenus",
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "32": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
